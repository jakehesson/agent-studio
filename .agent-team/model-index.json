    },
    "architect": {
      "tier": "reasoning",
      "rationale": "Technical specs, schemas, concurrency, and boundaries have highest downstream leverage."
    },
    "ux-designer": {
      "tier": "reasoning",
      "rationale": "Layout audits, visual hierarchy, multimodal UI inspection, and Z Fold 7 ergonomics.",
      "multimodalPreferred": true
    },
    "backend-engineer": {
      "tier": "balanced",
      "rationale": "Server, CLI, compiler, and unit-test throughput with strong coding precision."
    },
    "frontend-engineer": {
      "tier": "balanced",
      "rationale": "Interactive UI, SVG/CSS, and iterative typecheck/build fixes."
    },
    "code-reviewer": {
      "tier": "reasoning",
      "rationale": "Deep code review for security vulnerabilities, architecture conformance, concurrency bugs, performance regressions, and test coverage."
    },
    "vscode-copilot-specialist": {
      "tier": "reasoning",
      "rationale": "Read-only VS Code / GitHub Copilot validation across hooks, PushBus subagent re-homing, CopilotVSCodeAdapter enrichment, and live-follow SSE scoping."
    },
    "claude-code-specialist": {
      "tier": "reasoning",
      "rationale": "Read-only Claude Code validation across settings/hooks, PreToolUse deny contract, ClaudeCodeAdapter usage deduplication, /compact context tracking, and subagent correlation."
    },
    "antigravity-specialist": {
      "tier": "reasoning",
      "rationale": "Read-only Antigravity validation across plugin compilation, AntigravityAdapter full-file discovery, openToolCalls/pendingSpawns correlation, SSE streaming, and MCP App scoping."
    },
    "qa-validator": {
      "tier": "balanced",
      "rationale": "Deterministic checkpoint runs, MCP testrun recording, and accurate pass/fail bug triage."
    },
    "team-setup": {
      "tier": "balanced",
      "rationale": "Repo inspection, user interview, deterministic init/sync/doctor onboarding."
    }
  },
