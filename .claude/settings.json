{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx agent-studio hook-emit --ide claude-code --event PreToolUse",
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx agent-studio hook-emit --ide claude-code --event PostToolUse",
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx agent-studio hook-emit --ide claude-code --event SubagentStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx agent-studio hook-emit --ide claude-code --event SubagentStop",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx agent-studio hook-emit --ide claude-code --event Stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
