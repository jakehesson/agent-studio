{
  "name": "agent-studio-vscode",
  "displayName": "Agent Studio — Multi-Agent Monitor & Agile Board",
  "description": "IDE-agnostic live multi-agent topology monitor, QA-gated Agile Board, Agent Team inspector, and Setup/Doctor studio for VS Code and Antigravity.",
  "publisher": "agent-studio",
  "version": "0.16.0",
  "license": "MIT",
  "author": "Jake Hesson",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakehesson/agent-studio.git"
  },
  "homepage": "https://github.com/jakehesson/agent-studio#readme",
  "bugs": {
    "url": "https://github.com/jakehesson/agent-studio/issues"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "agent-studio",
    "multi-agent",
    "antigravity",
    "claude-code",
    "copilot",
    "mcp",
    "agile-board"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-studio",
          "title": "Agent Studio",
          "icon": "media/agent-studio-icon.svg"
        }
      ]
    },
    "views": {
      "agent-studio": [
        {
          "type": "webview",
          "id": "agentStudio.sidebar",
          "name": "Studio Overview"
        }
      ]
    },
    "commands": [
      {
        "command": "agentStudio.openStudio",
        "title": "Open Studio",
        "category": "Agent Studio"
      },
      {
        "command": "agentStudio.openBoard",
        "title": "Open Agile Board",
        "category": "Agent Studio"
      },
      {
        "command": "agentStudio.openTeam",
        "title": "Open Agent Team",
        "category": "Agent Studio"
      },
      {
        "command": "agentStudio.openDoctor",
        "title": "Open Setup & Doctor",
        "category": "Agent Studio"
      },
      {
        "command": "agentStudio.openInBrowser",
        "title": "Open in Browser",
        "category": "Agent Studio"
      },
      {
        "command": "agentStudio.initWorkspace",
        "title": "Onboard Workspace (Init & Sync)",
        "category": "Agent Studio"
      },
      {
        "command": "agentStudio.syncWorkspace",
        "title": "Sync IDE Adapters",
        "category": "Agent Studio"
      },
      {
        "command": "agentStudio.runDoctor",
        "title": "Run Doctor Check",
        "category": "Agent Studio"
      },
      {
        "command": "agentStudio.restartServer",
        "title": "Restart Server",
        "category": "Agent Studio"
      },
      {
        "command": "agentStudio.refreshModelIndex",
        "title": "Refresh Live Model Index",
        "category": "Agent Studio"
      }
    ],
    "configuration": {
      "title": "Agent Studio",
      "properties": {
        "agentStudio.port": {
          "type": "number",
          "default": 8767,
          "description": "Local TCP port for the Agent Studio HTTP/SSE server."
        },
        "agentStudio.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Bind host when Agent Studio spawns a managed local server (use 0.0.0.0 for LAN/Tailscale)."
        },
        "agentStudio.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the bundled Agent Studio server if no server is already running on the configured port."
        },
        "agentStudio.externalUrl": {
          "type": "string",
          "default": "",
          "description": "Optional external Studio URL (for example a Tailscale HTTPS URL like https://your-host.tailnet.ts.net:8767) used for Open in Browser and fallback viewing."
        },
        "agentStudio.mcpAutoRegister": {
          "type": "boolean",
          "default": true,
          "description": "Automatically register the bundled Agent Studio stdio MCP server via VS Code's MCP provider API when supported by the host IDE."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "agent-studio.mcp",
        "label": "Agent Studio Agile Board & Telemetry MCP"
      }
    ],
    "languageModelTools": [
      {
        "name": "agent_studio_ask_human",
        "toolReferenceName": "agent_studio_ask_human",
        "canBeReferencedInPrompt": true,
        "displayName": "Ask Human (Agent Studio)",
        "modelDescription": "Ask the human user 1 to 10 structured questions (single_select, multi_select, or free-text) or request approval directly in the Agent Studio Messages UI, waiting for their direct reply. Prefer this when Agent Studio is active; if Agent Studio is offline or unavailable, fall back to native vscode_askQuestions or ask in chat.",
        "userDescription": "Ask clarifying questions or request approval directly inside the Agent Studio Messages UI.",
        "inputSchema": {
          "type": "object",
          "required": [
            "questions"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 140,
              "description": "Short title for the question card in Agent Studio Messages."
            },
            "summary": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional concise context or rationale shown below the title."
            },
            "kind": {
              "type": "string",
              "enum": [
                "question",
                "approval"
              ],
              "description": "Prompt category ('question' or 'approval'). Defaults to 'question'."
            },
            "questions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "description": "1 to 10 questions to present to the user.",
              "items": {
                "type": "object",
                "required": [
                  "question",
                  "type",
                  "options"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Optional stable question identifier."
                  },
                  "header": {
                    "type": "string",
                    "description": "Optional short section header or tag for the question."
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The question text presented to the user."
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "single_select",
                      "multi_select",
                      "text"
                    ],
                    "description": "Input control type."
                  },
                  "options": {
                    "type": "array",
                    "description": "Selectable choices (use [] for pure text questions).",
                    "items": {
                      "type": "object",
                      "required": [
                        "label"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        },
                        "recommended": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "allowCustomInput": {
                    "type": "boolean",
                    "description": "Allow the user to enter custom text alongside predefined options."
                  },
                  "defaultValue": {
                    "type": "string",
                    "description": "Optional pre-selected option or default text value."
                  }
                }
              }
            },
            "agentId": {
              "type": "string",
              "description": "Optional originating agent identifier."
            },
            "agentLabel": {
              "type": "string",
              "description": "Optional human-readable originating agent label."
            },
            "sessionId": {
              "type": "string",
              "description": "Optional Agent Studio session ID to attribute this prompt to."
            },
            "timeoutSeconds": {
              "type": "number",
              "minimum": 5,
              "maximum": 1800,
              "description": "Maximum seconds to wait for a human response (5-1800, default 600)."
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc --noEmit && node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@jakehesson/agent-studio": "file:..",
    "agent-studio": "file:.."
  }
}
