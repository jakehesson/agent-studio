{
  "name": "@jakehesson/agent-studio",
  "version": "0.8.2",
  "description": "IDE-agnostic multi-agent orchestration, QA-gated Agile Board MCP, and live monitoring studio",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "author": "Jake Hesson",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakehesson/agent-studio.git"
  },
  "homepage": "https://github.com/jakehesson/agent-studio#readme",
  "bugs": {
    "url": "https://github.com/jakehesson/agent-studio/issues"
  },
  "keywords": [
    "agent-studio",
    "multi-agent",
    "mcp",
    "mcp-apps",
    "antigravity",
    "claude-code",
    "github-copilot",
    "vscode",
    "agile-board",
    "ai-agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agent-studio": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build && npm --prefix web run build",
    "build:plugin": "node antigravity-plugin/scripts/build-plugin.mjs",
    "prepublishOnly": "npm run build:all",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node -e \"const fs=require('fs'),p=require('path'),cp=require('child_process'),d='dist-test/tests/unit',f=fs.readdirSync(d).filter(x=>x.endsWith('.test.js')).sort().map(x=>p.join(d,x));process.exit(f.length?(cp.spawnSync(process.execPath,['--test',...f],{stdio:'inherit'}).status??1):1)\""
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
